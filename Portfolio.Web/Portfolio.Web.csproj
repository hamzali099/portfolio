<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Portfolio.Web</RootNamespace>
    <SpaRoot>..\ClientApp\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Data\profile.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Build the React app into wwwroot/app on publish -->
  <Target Name="BuildClientApp" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release' And '$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <DistFiles Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(DistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
